# Test Environment Configuration
# Sử dụng cho Jest tests

# Server Config
PORT=8004
NODE_ENV=test
SERVICE_TOKEN_SECRET=test-token-secret-change-me

# Kafka Config (Mock broker)
KAFKA_BROKER=localhost:9092

# Database Config (Test PostgreSQL)
DATABASE_URL=postgresql://test:test@localhost:5432/logic_test

# Cache Config (Test Redis)
REDIS_URL=redis://localhost:6379/1

# Google Sheets API Config (Will be mocked in tests)
GOOGLE_CREDENTIALS_JSON_FILE=credentials/service-account-key.json
GOOGLE_SHEET_ID=test-sheet-id-12345

# Logging
LOG_LEVEL=error
LOG_TO_FILE=false
