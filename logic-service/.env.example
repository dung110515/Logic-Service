# Server Config
PORT=8003
NODE_ENV=development

# Kafka Config
KAFKA_BROKER=kafka:9092

# Database Config (PostgreSQL + Prisma)
DATABASE_URL=postgresql://user:password@postgres:5432/logic_service_db

# Redis Config
REDIS_URI=redis://redis:6379

# Google Sheets Config
GOOGLE_SHEETS_API_KEY=your_api_key
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@project.iam.gserviceaccount.com
GOOGLE_SERVICE_ACCOUNT_KEY=your_private_key_json

# Services (internal Docker network)
AI_SERVICE_URL=http://ai-service:5000
NOTIFICATION_SERVICE_URL=http://notification-service:3001
PROXY_SERVICE_URL=http://proxy-service:3000

# Auth
X_SERVICE_TOKEN=your_internal_token
JWT_SECRET=your_secret_key

# Logging
LOG_LEVEL=info
