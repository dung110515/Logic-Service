# Default for local development (same as .env.local)
NODE_ENV=development
PORT=8003
SERVICE_TOKEN_SECRET=dev-local-service-token-change-me

# Infrastructure
DATABASE_URL=postgresql://soa:soa@localhost:5432/logic
KAFKA_BROKER=127.0.0.1:9094
REDIS_URL=redis://localhost:6379/0

# Optional Kafka auth
# KAFKA_USERNAME=
# KAFKA_PASSWORD=

# Optional Google Sheets
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
# GOOGLE_CREDENTIALS_JSON_FILE=credentials/service-account-key.json
# GOOGLE_SHEET_ID=

# Optional runtime features
# DISCORD_BOT_TOKEN=
MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=lms-files

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
