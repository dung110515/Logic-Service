{
  "name": "logic-service",
  "version": "1.0.0",
  "description": "Logic Service for SOA",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "npm run dev:local",
    "dev:local": "set ENV_FILE=.env.local&& ts-node src/index.ts",
    "dev:docker-env": "set ENV_FILE=.env.docker&& ts-node src/index.ts",
    "watch": "tsc --watch",
    "prisma:migrate": "prisma migrate dev",
    "prisma:generate": "prisma generate",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio --schema prisma/schema.prisma",
    "docker:up": "docker compose -f ..\\docker-compose.yml -f docker-compose.logic.yml up -d --build logic-service",
    "docker:down": "docker compose -f ..\\docker-compose.yml -f docker-compose.logic.yml stop logic-service",
    "docker:logs": "docker compose -f ..\\docker-compose.yml -f docker-compose.logic.yml logs -f logic-service"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^4.19.0",
    "kafkajs": "^2.2.4",
    "@prisma/client": "^5.8.0",
    "ioredis": "^5.3.2",
    "googleapis": "^140.0.0",
    "google-auth-library": "^9.4.1",
    "zod": "^3.22.4",
    "dotenv": "^16.3.1",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "ts-node": "^10.9.2",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "nodemon": "^3.0.2",
    "prisma": "^5.8.0"
  }
}
