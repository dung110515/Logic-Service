# Server Config
PORT=8003
NODE_ENV=development
SERVICE_TOKEN_SECRET=dev-local-service-token-change-me

# Kafka Config (container -> docker service)
KAFKA_BROKER=kafka:9092

# Database Config (container -> docker service)
DATABASE_URL=postgresql://soa:soa@postgres:5432/logic

# Cache Config (container -> docker service)
REDIS_URL=redis://redis:6379/0

# Object Storage (MinIO in docker network)
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minio
MINIO_SECRET_KEY=minio123
MINIO_BUCKET=lms-files

# Google Sheets API Config (Optional)
# GOOGLE_CREDENTIALS_JSON_FILE=credentials/service-account-key.json
# GOOGLE_SHEET_ID=

# Logging
LOG_LEVEL=info
LOG_TO_FILE=false
